# --- Supabase (Projekt in Region EU Central / Frankfurt anlegen!) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Nur serverseitig! Niemals mit NEXT_PUBLIC_ prefixen.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Öffentliche URL der App (für Einladungslinks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Web Push (VAPID) — erzeugen mit: npm run vapid ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.de

# --- Vercel Cron: Vercel sendet "Authorization: Bearer $CRON_SECRET" ---
CRON_SECRET=long-random-string

# --- Optional: Cloudflare Turnstile (Login & öffentliche Formulare). Ohne Schlüssel aus. ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: Sentry (EU-Region, z. B. https://KEY@o123.ingest.de.sentry.io/456). Ohne DSN aus. ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Karte: Tile-Server (OpenStreetMap-kompatibel), Standard tile.openstreetmap.org ---
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Demo-Modus erzwingen (Testdaten im Speicher, ohne Supabase) ---
# NEXT_PUBLIC_DEMO_MODE=1
